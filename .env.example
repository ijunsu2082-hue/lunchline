# Copy to .env for local use, or set these in Netlify (Site configuration > Environment variables).
# Everything is optional for local dev.

# Public address of the site (no trailing slash). Used for the setup links admins share.
# Unset: falls back to the request's own origin.
SITE_URL=https://your-site.netlify.app

# Secret (16+ characters) that signs device tokens and hashes IPs.
# Unset: the server generates one on first use and keeps it in Blobs.
SESSION_SECRET=

# Staff sign in with an email and password; admins add teammates with a setup link they copy and pass on.
# Nothing is emailed, so no email service is needed.

# Demo schools: a dozen ready-to-try schools (plus MASTER_SCHOOL) with photo menus that fill themselves.
# Set to off to skip creating them on a new site.
DEMO_SCHOOLS=

# Anthropic API key for the AI-written weekly report summary.
# Unset: reports are still built, with a plain numbers-based summary instead.
ANTHROPIC_API_KEY=

# Model used for the weekly summary. Unset: claude-sonnet-5-5.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Leading zero bits of proof-of-work a new device must solve. Higher = slower for everyone.
# Unset: 16.
POW_BITS=16

# Master code: a secret that signs in as MASTER_EMAIL (owner of MASTER_SCHOOL and the demo schools) with no password,
# so a live demo never depends on anyone's account. Off unless MASTER_CODE is 8+ characters. Treat it like a password.
MASTER_CODE=
MASTER_EMAIL=ajaysriramsankar@gmail.com
MASTER_SCHOOL=Irvine High School
