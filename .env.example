# Copy to .env for local use, or set these in Netlify (Site configuration > Environment variables).
# Everything is optional for local dev.

# Public address of the site (no trailing slash). Used for links in sign-in and report emails.
# Unset: falls back to the request's own origin (and Netlify's URL for the weekly report).
SITE_URL=https://your-site.netlify.app

# Secret (16+ characters) that signs device tokens and hashes IPs.
# Unset: the server generates one on first use and keeps it in Blobs.
SESSION_SECRET=

# ---- Email: pick ONE of Resend or Brevo (staff sign-in links, invites, weekly reports) ----
# Resend (https://resend.com). Its free test sender (onboarding@resend.dev) only delivers to the
# email you signed up with. To email other people, verify a domain and use it in FROM_EMAIL.
RESEND_API_KEY=

# Brevo (https://brevo.com), free for 300 emails a day. Works with ONE verified sender address
# (Senders & IP > Senders), no domain needed. Put that address in FROM_EMAIL.
BREVO_API_KEY=

# "From" address, e.g. LunchLine <hello@yourdomain.org> or just cafeteria@yourschool.edu.
# Resend unset: LunchLine <onboarding@resend.dev>. Brevo: must be a sender you verified.
FROM_EMAIL= 

# Neither key set: sign-in is refused in production (503) and printed to the console in local dev.

# Leading zero bits of proof-of-work a new device must solve. Higher = slower for everyone.
# Unset: 16.
POW_BITS=16