SITE_URL=https://your-site.netlify.app
#ours is just https://lunchline.netlify.app

# Secret (16+ characters) that signs device tokens and hashes IPs.
# Unset: the server generates one on first use and keeps it in Blobs.
SESSION_SECRET=

# Weare using Brevo (https://brevo.com), free for 300 emails a day. But it only works with ONE verified sender address
# Put the sender address that it says in Brevo in FROM_EMAIL.
BREVO_API_KEY=

# From Email address
FROM_EMAIL= 

# If you dont do either of these then you will get 503 error (Sign in isn't set up)

# Leading zero bits of proof-of-work a new device must solve. Higher = slower for everyone.
# Unset: 16.
POW_BITS=16